    "playwright-core": "^1.64.1",
    "typescript-eslint": "^8.71.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
