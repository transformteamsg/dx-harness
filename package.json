{
  "name": "dx-harness",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev",
    "prebuild": "node scripts/check-standards.mjs && pnpm run check:python",
    "build": "next build",
    "postbuild": "node scripts/externalize-next-inline-scripts.mjs",
    "check:standards": "node scripts/check-standards.mjs",
    "check:python": "python3 plugins/dx-harness/checks/validate.py --self-test && python3 plugins/dx-harness/checks/validate.py && python3 plugins/dx-harness/checks/checklib.py --self-test && python3 plugins/dx-harness/checks/token-audit.py --self-test && python3 plugins/dx-harness/checks/type-scan.py --self-test && python3 plugins/dx-harness/checks/token-audit.py app components lib && python3 plugins/dx-harness/checks/a11y-static.py app components && python3 plugins/dx-harness/checks/type-scan.py app components && python3 plugins/dx-harness/checks/contrast.py --tokens app/globals.css app components lib",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:icons": "node scripts/generate-ink-icons.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@radix-ui/colors": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.460.0",
    "motion": "^12.40.0",
    "next": "^15.3.0",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.19",
    "roughjs": "^4.6.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
