{
  "name": "dx-harness",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev",
    "prebuild": "node scripts/check-standards.mjs && pnpm run check:design && pnpm run check:records && pnpm run check:python && pnpm run check:notices",
    "build": "next build",
    "postbuild": "node scripts/externalize-next-inline-scripts.mjs",
    "check:standards": "node scripts/check-standards.mjs",
    "check:design": "python3 plugins/dx-harness/scripts/generate-design-json.py . --check",
    "check:records": "python3 plugins/dx-harness/checks/audit-record.py --self-test && python3 plugins/dx-harness/checks/audit-record.py",
    "check:python": "node scripts/run-python-checks.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:icons": "node scripts/generate-ink-icons.mjs",
    "gen:notices": "node scripts/generate-notices.mjs",
    "check:notices": "node scripts/generate-notices.mjs --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/anonymous-pro": "^5.3.0",
    "@radix-ui/colors": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.460.0",
    "motion": "^13.2.0",
    "next": "^15.5.25",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "roughjs": "^4.6.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
